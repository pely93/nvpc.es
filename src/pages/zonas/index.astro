---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import { business } from "@/data/business";

---
<BaseLayout title="Zonas de servicio" description="Atención presencial en Sevilla, Huelva, Cádiz, Córdoba y Málaga. Soporte remoto en el resto de Andalucía y España." canonical="/zonas/">
  <Breadcrumbs items={[{ label: "Zonas de servicio" }]} />
  <section class="container-nvpc interior-page">
    <h1 class="max-w-3xl text-3xl text-ink sm:text-4xl">Zonas de servicio</h1>

<p class="mt-4 max-w-3xl text-lg text-ink-soft">{business.coverage}</p>
<div class="mt-10 grid gap-6 lg:grid-cols-2">
 <div class="rounded-sm border border-border bg-surface p-7"><h2 class="text-2xl text-ink">Servicio presencial</h2>
 <ul class="mt-5 space-y-2 text-ink-soft">{business.onSiteProvinces.map(province => <li>{province}{province === "Sevilla" ? " — toda la provincia" : ""}</li>)}</ul>
 <p class="mt-5 text-ink-soft">{business.appointment}</p></div>
 <div class="rounded-sm border border-border bg-surface p-7"><h2 class="text-2xl text-ink">Soporte remoto</h2>
 <p class="mt-5 text-ink-soft">En Almería, Granada y Jaén, y en el resto de España, ofrecemos asistencia remota para las tareas que pueden resolverse a distancia.</p>
 <p class="mt-4 text-ink-soft">Las instalaciones físicas y las averías que requieren trabajar sobre el equipo se valoran según su ubicación y necesidades.</p></div>
</div>

  </section>
  <ContactCTA />
</BaseLayout>
