---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import ReviewCTA from "@/components/ReviewCTA.astro";
import { business } from "@/data/business";
---

<BaseLayout
  title="Contacto"
  description="Contacta con NVPC por teléfono, WhatsApp, email o formulario para solicitar presupuesto de servicios informáticos."
  canonical="/contacto/"
>
  <Breadcrumbs items={[{ label: "Contacto" }]} />

  <section class="container-nvpc py-[var(--space-section)]">
    <h1 class="max-w-2xl text-3xl font-bold text-ink sm:text-4xl">Contacto</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Cuéntanos qué necesita tu empresa. Respondemos en nuestro horario comercial: {business.schedule}.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div class="space-y-4">
        <a
          href={business.phoneHref}
          class="flex min-h-[44px] items-center gap-3 rounded-lg border border-border bg-paper p-5 font-semibold text-ink hover:border-brand hover:text-brand"
        >
          <span aria-hidden="true">📞</span> Llamar: {business.phoneDisplay}
        </a>
        <a
          href={`mailto:${business.email}`}
          class="flex min-h-[44px] items-center gap-3 rounded-lg border border-border bg-paper p-5 font-semibold text-ink hover:border-brand hover:text-brand"
        >
          <span aria-hidden="true">✉️</span> {business.email}
        </a>
        <WhatsAppButton class="w-full !justify-start !py-5 !text-base" />
        <p class="text-sm text-ink-soft">
          Horario: {business.schedule} · {business.areaPrimary}, con servicio remoto en toda España.
        </p>
      </div>

      <form class="space-y-4 rounded-lg border border-border bg-surface p-6" id="contact-form" novalidate>
        <p class="text-sm text-ink-soft">
          Formulario de contacto — el envío se gestiona desde tu proveedor de formularios habitual
          [PENDIENTE DE CONFIRMAR: conectar con el servicio de envío elegido]. Mientras tanto, usa el teléfono,
          el email o WhatsApp.
        </p>

        <div>
          <label for="name" class="block text-sm font-semibold text-ink">Nombre *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-1 w-full rounded-md border border-border bg-paper px-3 py-2.5 text-ink"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-ink">Email *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-1 w-full rounded-md border border-border bg-paper px-3 py-2.5 text-ink"
          />
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold text-ink">Teléfono</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="mt-1 w-full rounded-md border border-border bg-paper px-3 py-2.5 text-ink"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-ink">¿Qué necesitas? *</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1 w-full rounded-md border border-border bg-paper px-3 py-2.5 text-ink"
          ></textarea>
        </div>

        <p id="form-error" class="hidden text-sm font-semibold text-red-700" role="alert"></p>

        <button
          type="submit"
          class="flex min-h-[44px] w-full items-center justify-center rounded-md bg-brand px-5 py-2.5 font-semibold text-white hover:bg-brand-dark"
        >
          Enviar solicitud
        </button>
      </form>
    </div>

    <div class="mt-14 max-w-2xl">
      <ReviewCTA />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const error = document.getElementById("form-error");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      if (error) {
        error.textContent = "Revisa los campos obligatorios marcados con *.";
        error.classList.remove("hidden");
      }
      return;
    }
    error?.classList.add("hidden");
  });
</script>
