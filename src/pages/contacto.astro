---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import { business } from "@/data/business";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
---
<BaseLayout title="Contacto" description="Contacta con NVPC por teléfono, email o WhatsApp. Atención de lunes a viernes de 9:30 a 17:30 y visitas con cita previa." canonical="/contacto/">
  <Breadcrumbs items={[{ label: "Contacto" }]} />
  <section class="container-nvpc interior-page">
    <h1 class="max-w-3xl text-3xl text-ink sm:text-4xl">Contacto</h1>

<p class="mt-4 max-w-2xl text-lg text-ink-soft">Cuéntanos qué necesita tu empresa. Te atendemos en nuestro horario comercial: {business.schedule}.</p>
<div class="mt-10 grid gap-6 lg:grid-cols-2">
 <div class="contact-methods space-y-4">
  <a href={business.phoneHref} class="contact-method block rounded-sm border border-border bg-surface font-heading text-xl text-brand">Llamar: {business.phoneDisplay}</a>
  <a href={`mailto:${business.email}`} class="contact-method block rounded-sm border border-border bg-surface font-heading text-xl text-brand">{business.email}</a>
  <WhatsAppButton class="w-full !justify-start" size="lg" />
 </div>
 <div class="space-y-5 rounded-sm border border-border p-6 text-ink-soft">
  <h2 class="text-xl text-ink">Atención y visitas</h2>
  <p>{business.coverage}</p><p>{business.appointment}</p>
  <p><strong>Ubicación:</strong> {business.location}.</p>
  <p>Contacta antes de entregar o enviar un equipo o dispositivo. Te indicaremos el procedimiento y el punto de recepción.</p>
 </div>
</div>

  </section>
  <ContactCTA />
</BaseLayout>
