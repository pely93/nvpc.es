---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import ClientLogos from "@/components/ClientLogos.astro";
---
<BaseLayout title="Clientes y colaboraciones" description="Clientes y colaboraciones de Networking Virtual PC. Soporte y soluciones tecnológicas para empresas y profesionales." canonical="/clientes/">
  <Breadcrumbs items={[{ label: "Clientes y colaboraciones" }]} />
  <section class="container-nvpc interior-page">
    <h1 class="max-w-3xl text-3xl text-ink sm:text-4xl">Clientes y colaboraciones</h1>

<p class="mt-4 max-w-2xl text-lg text-ink-soft">Trabajamos con empresas, clínicas y profesionales que cuentan con nosotros para sus necesidades tecnológicas.</p>
<ClientLogos showBrands />

  </section>
  <ContactCTA />
</BaseLayout>
