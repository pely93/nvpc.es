---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import { business } from "@/data/business";
import ReviewCTA from "@/components/ReviewCTA.astro";
---
<BaseLayout title="Gracias por confiar en NVPC" description="Comparte tu experiencia o una sugerencia con Networking Virtual PC." canonical="/opinion/">
  <Breadcrumbs items={[{ label: "Gracias por confiar en NVPC" }]} />
  <section class="container-nvpc py-[var(--space-section)]">
    <h1 class="max-w-3xl text-3xl text-ink sm:text-4xl">Gracias por confiar en NVPC</h1>

<p class="mt-4 max-w-2xl text-lg text-ink-soft">Tu opinión nos ayuda a mejorar. Si quieres compartir tu experiencia o hacernos una sugerencia, escríbenos a {business.email}.</p>
<div class="mt-8 max-w-2xl"><ReviewCTA /></div>

  </section>
  <ContactCTA />
</BaseLayout>
