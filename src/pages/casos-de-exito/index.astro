---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import { getCollection } from "astro:content";

const cases = (await getCollection("cases")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Casos de éxito"
  description="Casos de trabajo reales de NVPC: mantenimiento, redes, seguridad, recuperación de datos y diseño web para empresas."
  canonical="/casos-de-exito/"
>
  <Breadcrumbs items={[{ label: "Casos de éxito" }]} />

  <section class="container-nvpc py-[var(--space-section)]">
    <h1 class="max-w-2xl text-3xl text-ink sm:text-4xl">Casos de éxito</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Ejemplos de trabajos realizados para empresas y profesionales. Los casos marcados como borrador están pendientes de confirmación antes de su publicación definitiva.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {cases.map((item) => (
        <CaseStudyCard
          title={item.data.title}
          service={item.data.service}
          location={item.data.location}
          clientType={item.data.clientType}
          result={item.data.result}
          href={`/casos-de-exito/${item.slug}/`}
          draft={item.data.draft}
        />
      ))}
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
