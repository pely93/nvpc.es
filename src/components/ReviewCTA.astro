---
import { business } from "@/data/business";
type Props = { compact?: boolean };
const { compact = false } = Astro.props;
---
<div class={`rounded-sm border border-border bg-surface ${compact ? "p-4" : "p-6 sm:p-8"}`}>
 <p class="font-heading text-xl text-ink">Tu opinión nos ayuda a mejorar.</p>
 <p class="mt-2 text-sm text-ink-soft">Si hemos trabajado contigo, puedes compartir tu experiencia o hacernos una sugerencia por email.</p>
 <a href={`mailto:${business.email}?subject=Mi%20experiencia%20con%20NVPC`} class="mt-4 inline-flex min-h-[44px] items-center rounded-sm bg-brand px-5 py-3 text-sm font-semibold text-paper">Compartir mi experiencia</a>
</div>
