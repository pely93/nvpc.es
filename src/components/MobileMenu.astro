---
import { mainNav } from "@/data/navigation";
import { business } from "@/data/business";
import { withBase } from "@/config";
import BrandLogo from "@/components/BrandLogo.astro";
import PrimaryButton from "@/components/PrimaryButton.astro";
const currentPath = Astro.url.pathname;
---
<div class="shrink-0 xl:hidden">
  <button id="mobile-menu-button" type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú de navegación">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
  </button>
  <dialog id="mobile-menu" class="mobile-menu" aria-label="Menú de navegación">
    <div class="mobile-menu-heading border-b border-border">
      <div class="container-nvpc masthead-row">
        <BrandLogo />
        <form method="dialog">
          <button id="mobile-menu-close" type="submit" class="menu-toggle" aria-label="Cerrar menú de navegación" autofocus>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </form>
      </div>
    </div>
    <nav aria-label="Navegación móvil" class="mobile-menu-content container-nvpc">
      <ul class="divide-y divide-border font-heading text-xl text-ink">
        {mainNav.map(item => <li>
          <a href={withBase(item.href)} aria-current={currentPath.startsWith(withBase(item.href)) ? "page" : undefined} class="block min-h-[48px] whitespace-nowrap py-3 hover:text-brand aria-[current=page]:text-brand">{item.label}</a>
        </li>)}
      </ul>
      <div class="mt-6 grid gap-3">
        <PrimaryButton href="/contacto/">Solicitar presupuesto</PrimaryButton>
        <PrimaryButton href={business.phoneHref} variant="outline">Llamar: {business.phoneDisplay}</PrimaryButton>
      </div>
    </nav>
  </dialog>
</div>
<script>
  const button = document.querySelector<HTMLButtonElement>("#mobile-menu-button");
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const desktop = window.matchMedia("(min-width: 80rem)");
  let previousOverflow = "";

  button?.addEventListener("click", () => {
    if (!menu || menu.open) return;
    previousOverflow = document.body.style.overflowY;
    menu.showModal();
    button.setAttribute("aria-expanded", "true");
    document.body.style.overflowY = "hidden";
  });

  // Native dialog keeps focus in the menu and supports Escape and the close form.
  menu?.addEventListener("close", () => {
    document.body.style.overflowY = previousOverflow;
    button?.setAttribute("aria-expanded", "false");
    if (!desktop.matches) button?.focus({ preventScroll: true });
  });
  menu?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => menu.close());
  });
  desktop.addEventListener("change", event => {
    if (event.matches && menu?.open) menu.close();
  });
</script>
