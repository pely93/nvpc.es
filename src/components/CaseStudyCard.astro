---
import { withBase } from "@/config";

type Props = {
  title: string;
  service: string;
  location: string;
  clientType: string;
  result: string;
  href: string;
  draft?: boolean;
};

const { title, service, location, clientType, result, href, draft = false } = Astro.props;
const resolvedHref = withBase(href);
---

<article class="flex flex-col gap-3 rounded-[3px] border border-border bg-paper p-6">
  {draft && (
    <p class="w-fit rounded-[3px] bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wide text-ink-soft">
      Borrador · pendiente de confirmar
    </p>
  )}
  <p class="text-xs font-semibold uppercase tracking-wide text-brand">{service} · {location}</p>
  <h3 class="font-heading text-xl text-ink">
    <a href={resolvedHref} class="hover:text-brand">{title}</a>
  </h3>
  <p class="text-sm text-ink-soft"><strong class="text-ink">Tipo de cliente:</strong> {clientType}</p>
  <p class="text-sm text-ink-soft"><strong class="text-ink">Resultado:</strong> {result}</p>
  <a href={resolvedHref} class="mt-1 inline-flex items-center gap-1 font-semibold text-brand hover:underline">
    Ver caso
    <span aria-hidden="true">→</span>
  </a>
</article>
