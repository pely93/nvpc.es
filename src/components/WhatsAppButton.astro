---
import { business } from "@/data/business";

type Props = {
  class?: string;
  label?: string;
};

const { class: className = "", label = "Hablar por WhatsApp" } = Astro.props;
---

<a
  href={business.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`label-caps inline-flex items-center justify-center gap-2 rounded-[3px] bg-[#25D366] px-5 py-2.5 min-h-[44px] text-xs text-paper hover:brightness-95 ${className}`}
  aria-label={`${label} (se abre en una ventana nueva)`}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.44 1.32 4.94L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.11.11-1.79-.11-.41-.13-.94-.3-1.61-.6-2.84-1.23-4.69-4.1-4.83-4.29-.14-.19-1.16-1.54-1.16-2.93 0-1.4.73-2.08 1-2.36.24-.28.55-.34.73-.34h.53c.17 0 .4-.02.62.48.24.55.81 1.9.88 2.04.07.14.11.3.02.48-.08.19-.13.3-.26.46-.14.16-.28.36-.4.48-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.19-.28.37-.23.62-.14.25.09 1.59.75 1.87.89.28.14.46.21.53.32.07.12.07.68-.17 1.35Z" />
  </svg>
  {label}
</a>
