---
import { business } from "@/data/business";
import { footerServiceLinks, footerLocationLinks } from "@/data/navigation";
import { withBase } from "@/config";

const year = new Date().getFullYear();
---

<footer class="bg-brand-dark text-on-brand-dim">
  <div class="container-nvpc grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <p class="flex items-center gap-2.5 font-heading text-lg font-semibold text-on-brand">
        <img src={withBase("/logo-mark.svg")} alt="" width="32" height="32" class="h-8 w-8" />
        NVPC
      </p>
      <p class="mt-1 text-sm text-on-brand-muted">Networking Virtual PC</p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Soporte técnico y soluciones informáticas para empresas y profesionales en Sevilla, con servicio remoto para toda España.
      </p>
    </div>

    <nav aria-label="Servicios en el pie de página" class="lg:border-l lg:border-on-brand-rule lg:pl-8">
      <h2 class="label-caps text-xs text-on-brand-faint">Servicios</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {footerServiceLinks.map((link) => (
          <li><a href={withBase(link.href)} class="hover:text-on-brand">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Zonas de servicio en el pie de página" class="lg:border-l lg:border-on-brand-rule lg:pl-8">
      <h2 class="label-caps text-xs text-on-brand-faint">Zonas de servicio</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {footerLocationLinks.map((link) => (
          <li><a href={withBase(link.href)} class="hover:text-on-brand">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="lg:border-l lg:border-on-brand-rule lg:pl-8">
      <h2 class="label-caps text-xs text-on-brand-faint">Contacto</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={business.phoneHref} class="hover:text-on-brand">{business.phoneDisplay}</a></li>
        <li><a href={`mailto:${business.email}`} class="hover:text-on-brand">{business.email}</a></li>
        <li>{business.schedule}</li>
        <li>{business.areaPrimary}</li>
        <li><a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-on-brand">WhatsApp</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-on-brand-rule py-6">
    <div class="container-nvpc flex flex-col gap-2 text-xs text-on-brand-faint sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} NVPC · Networking Virtual PC. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <a href={withBase("/sobre-nvpc/")} class="hover:text-on-brand">Sobre NVPC</a>
        <a href={withBase("/opinion/")} class="hover:text-on-brand">Opinión</a>
        <a href={withBase("/contacto/")} class="hover:text-on-brand">Contacto</a>
      </div>
    </div>
  </div>
</footer>
