---
import type { PricingPlan } from "@/data/pricing";
import PrimaryButton from "@/components/PrimaryButton.astro";

type Props = { plan: PricingPlan };
const { plan } = Astro.props;
---

<article
  class={`flex flex-col gap-5 border p-6 sm:p-8 ${
    plan.highlighted ? "border-t-2 border-t-accent border-border bg-surface" : "border-border bg-paper"
  }`}
>
  {plan.highlighted && (
    <p class="label-caps w-fit text-xs text-accent">
      Más elegido
    </p>
  )}
  <header>
    <h3 class="font-heading text-xl text-ink">{plan.name}</h3>
    <p class="mt-1 text-sm text-ink-soft">{plan.audience}</p>
  </header>
  <p class="font-heading text-lg text-brand">{plan.priceNote}</p>
  <p class="text-sm text-ink-soft">{plan.description}</p>

  <div>
    <h4 class="label-caps text-xs text-ink-faint">Qué incluye</h4>
    <ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
      {plan.includes.map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-brand">✓</span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  <div>
    <h4 class="label-caps text-xs text-ink-faint">Qué no incluye</h4>
    <ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
      {plan.excludes.map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-ink-soft">–</span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  <PrimaryButton href="/contacto/" size="lg" class="mt-auto justify-center">
    {plan.ctaLabel}
  </PrimaryButton>
</article>
