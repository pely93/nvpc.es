---
import type { PricingPlan } from "@/data/pricing";
import PrimaryButton from "@/components/PrimaryButton.astro";

type Props = { plan: PricingPlan };
const { plan } = Astro.props;
---

<article
  class={`flex flex-col gap-5 rounded-lg border p-6 sm:p-8 ${
    plan.highlighted ? "border-brand bg-surface shadow-sm ring-1 ring-brand" : "border-border bg-paper"
  }`}
>
  {plan.highlighted && (
    <p class="w-fit rounded-full bg-brand px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
      Más elegido
    </p>
  )}
  <header>
    <h3 class="font-heading text-xl font-bold text-ink">{plan.name}</h3>
    <p class="mt-1 text-sm text-ink-soft">{plan.audience}</p>
  </header>
  <p class="text-lg font-bold text-brand">{plan.priceNote}</p>
  <p class="text-sm text-ink-soft">{plan.description}</p>

  <div>
    <h4 class="text-sm font-semibold text-ink">Qué incluye</h4>
    <ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
      {plan.includes.map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-brand">✓</span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  <div>
    <h4 class="text-sm font-semibold text-ink">Qué no incluye</h4>
    <ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
      {plan.excludes.map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-ink-soft">–</span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  <PrimaryButton href="/contacto/" size="lg" class="mt-auto justify-center">
    {plan.ctaLabel}
  </PrimaryButton>
</article>
