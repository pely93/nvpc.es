---
import { withBase } from "@/config";

type Props = {
  title: string;
  problem: string;
  solution: string;
  benefit: string;
  href: string;
  featured?: boolean;
};

const { title, problem, solution, benefit, href, featured = false } = Astro.props;
const resolvedHref = withBase(href);
---

<article
  class={`flex flex-col gap-4 border-t-2 border-border bg-paper p-6 ${
    featured ? "sm:col-span-2 sm:p-8 border-t-brand" : ""
  }`}
>
  <h3 class={`font-heading ${featured ? "text-2xl" : "text-xl"} text-ink`}>
    <a href={resolvedHref} class="hover:text-brand">{title}</a>
  </h3>
  <dl class="grid gap-3 text-sm text-ink-soft">
    <div>
      <dt class="label-caps text-xs text-ink-faint">Problema</dt>
      <dd class="mt-0.5 text-ink">{problem}</dd>
    </div>
    <div>
      <dt class="label-caps text-xs text-ink-faint">Solución</dt>
      <dd class="mt-0.5 text-ink">{solution}</dd>
    </div>
    <div>
      <dt class="label-caps text-xs text-ink-faint">Beneficio</dt>
      <dd class="mt-0.5 text-ink">{benefit}</dd>
    </div>
  </dl>
  <a href={resolvedHref} class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-brand hover:underline">
    Ver servicio
    <span aria-hidden="true">→</span>
  </a>
</article>
