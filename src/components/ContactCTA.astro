---
import PrimaryButton from "@/components/PrimaryButton.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { business } from "@/data/business";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Cuéntanos qué necesita tu empresa",
  description = "Escríbenos, llama o envía un WhatsApp. Te respondemos en horario comercial y te proponemos la solución más adecuada.",
} = Astro.props;
---

<section class="border-t-2 border-accent bg-brand py-[var(--space-section)] text-on-brand-dim">
  <div class="container-nvpc flex flex-col items-start gap-6">
    <div class="max-w-2xl">
      <h2 class="text-2xl text-on-brand sm:text-3xl">{title}</h2>
      <p class="mt-3">{description}</p>
    </div>
    <div class="contact-actions">
      <PrimaryButton href="/contacto/" variant="solid" size="lg" class="button-on-dark">
        Solicitar presupuesto
      </PrimaryButton>
      <PrimaryButton href={business.phoneHref} variant="outline" size="lg" class="button-outline-on-dark">
        Llamar: {business.phoneDisplay}
      </PrimaryButton>
      <WhatsAppButton size="lg" />
    </div>
  </div>
</section>
