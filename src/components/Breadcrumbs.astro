---
import { siteUrl, withBase } from "@/config";

type Crumb = { label: string; href?: string };
type Props = { items: Crumb[] };

const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.slice(base.length);
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [{ label: "Inicio", href: "/" }, ...items].map((item, index) => ({
    "@type": "ListItem", position: index + 1, name: item.label,
    item: `${siteUrl}${item.href ?? currentPath}`,
  })),
};
---

<nav aria-label="Migas de pan" class="border-b border-border bg-surface">
  <ol class="container-nvpc flex flex-wrap items-center gap-1 py-3 text-sm text-ink-soft">
    <li>
      <a href={withBase("/")} class="hover:text-brand">Inicio</a>
    </li>
    {
      items.map((item, i) => (
          <li class="flex min-w-0 items-baseline gap-2" aria-current={i === items.length - 1 ? "page" : undefined}>
            <span aria-hidden="true" class="shrink-0">/</span>
            {item.href ? (
              <a href={withBase(item.href)} class="hover:text-brand">
                {item.label}
              </a>
            ) : (
              <span class="min-w-0 font-medium text-ink">{item.label}</span>
            )}
          </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} is:inline />
