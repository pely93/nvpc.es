---
import { mainNav } from "@/data/navigation";
import { business } from "@/data/business";
import { withBase } from "@/config";
import PrimaryButton from "@/components/PrimaryButton.astro";
import MobileMenu from "@/components/MobileMenu.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-paper shadow-[0_1px_0_var(--color-border)]">
  <div class="container-nvpc flex h-16 items-center justify-between gap-4 sm:h-20">
    <a href={withBase("/")} class="flex items-center gap-2.5 font-heading text-lg font-semibold text-ink">
      <span class="flex h-9 w-9 items-center justify-center rounded-[3px] bg-brand text-sm font-semibold text-paper" aria-hidden="true">
        NV
      </span>
      NVPC
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="label-caps flex items-center gap-7 text-xs text-ink-soft">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={currentPath.startsWith(withBase(item.href)) ? "page" : undefined}
                class="border-b-2 border-transparent pb-1 hover:text-ink aria-[current=page]:border-accent aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={business.phoneHref} class="text-sm font-medium text-ink-soft hover:text-brand">
        {business.phoneDisplay}
      </a>
      <PrimaryButton href="/contacto/" size="md">Solicitar presupuesto</PrimaryButton>
    </div>

    <MobileMenu />
  </div>
</header>
