---
import { mainNav } from "@/data/navigation";
import { business } from "@/data/business";
import { withBase } from "@/config";
import BrandLogo from "@/components/BrandLogo.astro";
import PrimaryButton from "@/components/PrimaryButton.astro";
import MobileMenu from "@/components/MobileMenu.astro";

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-border">
  <div class="container-nvpc masthead-row">
    <BrandLogo />

    <nav aria-label="Navegación principal" class="hidden xl:block">
      <ul class="label-caps flex items-center gap-4 text-xs text-ink-soft">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={currentPath.startsWith(withBase(item.href)) ? "page" : undefined}
                class="whitespace-nowrap border-b-2 border-transparent pb-1 hover:text-ink aria-[current=page]:border-accent aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden shrink-0 items-center gap-3 xl:flex">
      <a href={business.phoneHref} class="whitespace-nowrap text-sm font-medium text-ink-soft hover:text-brand">
        {business.phoneDisplay}
      </a>
      <PrimaryButton href="/contacto/" size="md">Solicitar presupuesto</PrimaryButton>
    </div>

    <MobileMenu />
  </div>
</header>
