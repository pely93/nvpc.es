---
type Step = { title: string; description: string };
type Props = { steps: Step[]; title?: string };

const {
  steps,
  title = "Cómo trabajamos",
} = Astro.props;
---

<section aria-labelledby="process-heading">
  <h2 id="process-heading" class="text-2xl text-ink sm:text-3xl">{title}</h2>
  <ol class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, i) => (
        <li class="border-t-2 border-border pt-4">
          <span class="font-heading text-3xl text-accent" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 font-medium text-ink">{step.title}</h3>
          <p class="mt-1 text-sm text-ink-soft">{step.description}</p>
        </li>
      ))
    }
  </ol>
</section>
