DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Leave certificate renewal challenges available.
RewriteRule ^\.well-known/acme-challenge/ - [L]

RewriteCond %{HTTP_HOST} !^nvpc\.es$ [NC]
RewriteRule ^ https://nvpc.es%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://nvpc.es%{REQUEST_URI} [R=301,L]

# Preserve the main URLs of the former WordPress site.
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^pagina-ejemplo/donde-nos-encontramos/?$ /contacto/ [R=301,L]
RewriteRule ^pagina-ejemplo/redes-sociales/?$ /clientes/ [R=301,L]
RewriteRule ^pagina-ejemplo/?$ /sobre-nvpc/ [R=301,L]
RewriteRule ^servicios-y-mantenimiento-informatico/?$ /servicios/mantenimiento-informatico/ [R=301,L]
RewriteRule ^redes-2/?$ /servicios/redes-wifi/ [R=301,L]
RewriteRule ^diseno-web/?$ /servicios/diseno-web/ [R=301,L]
</IfModule>
